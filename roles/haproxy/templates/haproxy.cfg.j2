global
    log /dev/log local0
    maxconn 50000
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    option  redispatch
    retries 3
    timeout connect 5s
    timeout client 1m
    timeout server 1m
    timeout http-request 10s
    timeout http-keep-alive 10s
    timeout check 5s
    timeout queue 10s

frontend fe_http
    bind *:80
{% if crowdsec_enabled | bool %}
    unique-id-format %[uuid()]
    filter spoe engine crowdsec config /etc/haproxy/crowdsec.cfg
{% endif %}
    acl lb_check path /lb-check
{% if keycloak_site in haproxy_maintenance_sites %}
    http-request return status 503 content-type text/plain string "maintenance\n" if lb_check
{% else %}
    http-request return status 200 content-type text/plain string "ok\n" if lb_check { nbsrv(be_keycloak) gt 0 }
    http-request return status 503 content-type text/plain string "down\n" if lb_check
{% endif %}
{% if crowdsec_enabled | bool %}
    http-request send-spoe-group crowdsec crowdsec-http-no-body if !lb_check !{ path_beg /.well-known/acme-challenge/ }
    http-request deny deny_status 403 if !lb_check !{ path_beg /.well-known/acme-challenge/ } { var(txn.crowdsec.remediation) -m str ban }
{% endif %}
{% if keycloak_external | bool %}
    acl acme path_beg /.well-known/acme-challenge/
    use_backend be_acme if acme
{% endif %}
    redirect scheme https code 301

frontend fe_https
    bind *:443 ssl crt /etc/haproxy/certs/keycloak.pem
{% if crowdsec_enabled | bool %}
    unique-id-format %[uuid()]
    filter spoe engine crowdsec config /etc/haproxy/crowdsec.cfg
{% endif %}
    http-request del-header X-Forwarded-For
    http-request del-header X-Forwarded-Proto
    http-request del-header X-Forwarded-Host
    http-request del-header X-Forwarded-Port
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port 443
    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    http-response set-header X-Content-Type-Options nosniff
    http-response set-header X-Frame-Options SAMEORIGIN
    http-response set-header Referrer-Policy strict-origin-when-cross-origin
    http-response del-header Server
    http-response del-header X-Powered-By

    stick-table type ip size 200000 expire 10m store http_req_rate(10s)
    acl lb_check path /lb-check
    acl is_admin path_beg /admin
    acl is_admin path_beg /realms/master
    acl is_login path_sub /protocol/openid-connect/token
    acl is_login path_sub /protocol/openid-connect/auth
    acl is_login path_sub /login-actions/
    http-request deny deny_status 403 if { method TRACE }
{% if keycloak_admin_cidrs | length == 0 %}
    http-request deny deny_status 403 if is_admin
{% else %}
    acl admin_net src {{ keycloak_admin_cidrs | join(' ') }}
    http-request deny deny_status 403 if is_admin !admin_net
{% endif %}
    http-request track-sc0 src if !lb_check
    http-request track-sc1 src table be_login_rate if is_login
    http-request deny deny_status 429 if !lb_check { sc_http_req_rate(0) gt {{ keycloak_http_rate_limit }} }
    http-request deny deny_status 429 if is_login { sc_http_req_rate(1) gt {{ keycloak_login_rate_limit }} }
{% if keycloak_site in haproxy_maintenance_sites %}
    http-request return status 503 content-type text/plain string "maintenance\n" if lb_check
{% else %}
    http-request return status 200 content-type text/plain string "ok\n" if lb_check { nbsrv(be_keycloak) gt 0 }
    http-request return status 503 content-type text/plain string "down\n" if lb_check
{% endif %}
{% if crowdsec_enabled | bool %}
    http-request send-spoe-group crowdsec crowdsec-http-no-body if !lb_check
    http-request deny deny_status 403 if !lb_check { var(txn.crowdsec.remediation) -m str ban }
{% endif %}
    default_backend be_keycloak

backend be_login_rate
    stick-table type ip size 200000 expire 10m store http_req_rate(10s)

backend be_keycloak
    balance roundrobin
    option httpchk
    http-check send meth GET uri /health/ready ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
    default-server inter 5s fall 3 rise 2
{% for host in groups['keycloak'] %}
{% set kc_addr = '127.0.0.1' if host == inventory_hostname else hostvars[host].ansible_host %}
    server {{ host }} {{ kc_addr }}:{{ keycloak_http_port }} check port {{ keycloak_management_port }}{% if keycloak_management_scheme == 'https' %} check-ssl verify none{% endif %}{% if hostvars[host].keycloak_role == 'passive' %} backup{% endif %}

{% endfor %}

{% if crowdsec_enabled | bool %}
backend crowdsec-spoa
    mode tcp
    timeout connect 2s
    timeout server 60s
    server spoa 127.0.0.1:{{ crowdsec_spoa_port }}

{% endif %}
frontend fe_stats
    bind 127.0.0.1:{{ haproxy_stats_port }}
    stats enable
    stats uri /stats
    stats refresh 10s
{% if keycloak_external | bool %}

backend be_acme
    server certbot 127.0.0.1:{{ keycloak_acme_http_port }}
{% endif %}
