map $http_upgrade $kc_connection {
    default upgrade;
    "" close;
}

server {
    listen 80 default_server;
    server_name {{ keycloak_hostname }};
    access_log /var/log/nginx/keycloak-access.log;
    error_log /var/log/nginx/keycloak-error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }

    location = /lb-check {
        proxy_pass http://127.0.0.1:{{ keycloak_management_port }}/health/ready;
        proxy_set_header Host 127.0.0.1;
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen {{ keycloak_https_port }} ssl default_server;
    server_name {{ keycloak_hostname }};
    access_log /var/log/nginx/keycloak-access.log;
    error_log /var/log/nginx/keycloak-error.log;

    ssl_certificate /etc/keycloak/certs/tls.crt;
    ssl_certificate_key /etc/keycloak/certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /lb-check {
        proxy_pass http://127.0.0.1:{{ keycloak_management_port }}/health/ready;
        proxy_set_header Host 127.0.0.1;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ keycloak_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port {{ keycloak_https_port }};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $kc_connection;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
        client_max_body_size 20m;
    }
}
