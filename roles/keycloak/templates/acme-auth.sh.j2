#!/bin/bash
set -euo pipefail
install -d -m 0755 /var/www/acme/.well-known/acme-challenge
printf '%s\n' "${CERTBOT_VALIDATION}" > "/var/www/acme/.well-known/acme-challenge/${CERTBOT_TOKEN}"
chmod 0644 "/var/www/acme/.well-known/acme-challenge/${CERTBOT_TOKEN}"
{
  printf 'ACME\n%s\n%s\n' "${CERTBOT_TOKEN}" "${CERTBOT_VALIDATION}"
} | ssh -i /etc/letsencrypt/passive.key \
  -o IdentitiesOnly=yes \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile=/etc/letsencrypt/known_hosts \
  "{{ keycloak_passive_user }}@{{ keycloak_passive_address }}"
