# Скопируйте в realms/apps.yml. Файл *.example плейбук не импортирует.
# AD: loginTheme: nemero-ad · FreeIPA: loginTheme: nemero-freeipa
realm: apps
enabled: true
displayName: Applications
loginTheme: nemero-freeipa
sslRequired: external
registrationAllowed: false
loginWithEmailAllowed: true
duplicateEmailsAllowed: false
resetPasswordAllowed: true
rememberMe: true
editUsernameAllowed: false
bruteForceProtected: true
accessTokenLifespan: 300
ssoSessionIdleTimeout: 1800
ssoSessionMaxLifespan: 36000
roles:
  realm:
    - name: user
      description: Пользователь приложений
clients:
  - clientId: sample-app
    name: Sample application
    enabled: true
    protocol: openid-connect
    publicClient: false
    secret: "{{ vault_keycloak_client_apps_sample_app }}"
    redirectUris:
      - https://app.example.com/*
    webOrigins:
      - https://app.example.com
    standardFlowEnabled: true
    directAccessGrantsEnabled: false
    serviceAccountsEnabled: false
